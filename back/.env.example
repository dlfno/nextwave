# LLM (opcional): sin key todo funciona con fallbacks deterministas
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Servicios (DECISIONS #33). Por defecto: wallet :3001, merchant :3002, agent :3003.
# Solo hay que tocarlos para desplegar cada parte en otro host.
# WALLET_URL=http://localhost:3001
# MERCHANT_URL=http://localhost:3002
# PORT=  # fuerza el puerto del servicio que arranque bin/www (según APP)

# Ninguna fuente de datos de producto necesita API key (DECISIONS #32).

# Presupuestos del scraper (ms). Los valores por defecto dejan un ticket en ~20-25 s.
# SCRAPE_ADAPTER_MS=25000
# SCRAPE_PAGE_MS=11000
# SCRAPE_TIMEOUT_MS=9000
# SCRAPE_TTL_MS=900000
