#!/usr/bin/env node

/**
 * Module dependencies.
 */

var debug = require('debug')('back:server');
var http = require('http');

// APP selecciona qué servicio levantar (DECISIONS #33). Sin APP: el monolito en :3000.
var APPS = {
  wallet: ['../apps/wallet', 3001],
  merchant: ['../apps/merchant', 3002],
  agent: ['../apps/agent', 3003],
  all: ['../app', 3000],
};
var which = APPS[process.env.APP || 'all'] || APPS.all;

// Modo monolito: los 3 routers viven en este proceso, así que las llamadas entre servicios
// (merchant → wallet /verify) deben volver a este mismo puerto, no a :3001/:3002.
if ((process.env.APP || 'all') === 'all') {
  var selfPort = process.env.PORT || String(which[1]);
  process.env.WALLET_URL = process.env.WALLET_URL || 'http://localhost:' + selfPort;
  process.env.MERCHANT_URL = process.env.MERCHANT_URL || 'http://localhost:' + selfPort;
}

var app = require(which[0]);

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || String(which[1]));
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
